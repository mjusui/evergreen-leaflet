{
  "manifest_version": 3,
  "name": "Evergreen Leaflet",
  "description": "Manual with browser run step by step",
  "version": "1.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "48": "icon.svg"
    }
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "permissions": ["sidePanel"]
}
